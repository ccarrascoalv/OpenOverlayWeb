---
/**
 * Marco para una captura real de la app. Respeta la proporción de la captura.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
}
const { image, alt } = Astro.props;
---

<figure class="shot">
  <Image
    src={image}
    alt={alt}
    widths={[800, 1280, 1920, image.width]}
    sizes="(min-width: 1360px) 1280px, calc(100vw - 2rem)"
    quality={90}
    loading="lazy"
    decoding="async"
    class="shot-img"
  />
</figure>

<style>
  .shot {
    margin: 0;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-3);
    background: var(--c-bg);
    overflow: hidden;
    box-shadow: 0 30px 60px -30px var(--c-shadow);
  }

  .shot :global(.shot-img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
