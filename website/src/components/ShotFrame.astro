---
/**
 * Marco para una "captura" de la app con proporción fija (16:10).
 * Hoy contiene un mockup HTML (slot). Para usar una captura real, pasa `image` y `alt`:
 *
 *   <ShotFrame label="Panel de control" image={controlPanelPng} alt="Panel de control de OpenOverlay" />
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  label: string;
  image?: ImageMetadata;
  alt?: string;
}
const { label, image, alt = '' } = Astro.props;
---

<figure class="shot">
  {
    image ? (
      <Image src={image} alt={alt} widths={[640, 1280]} sizes="(min-width: 1000px) 640px, 92vw" class="shot-img" />
    ) : (
      <div class="shot-mock" role="img" aria-label={label}>
        <div class="shot-inner" aria-hidden="true">
          <slot />
        </div>
      </div>
    )
  }
</figure>

<style>
  .shot {
    margin: 0;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-3);
    background: var(--c-bg);
    overflow: hidden;
    box-shadow: 0 30px 60px -30px var(--c-shadow);
  }

  .shot-mock {
    container-type: inline-size;
  }

  .shot-mock,
  .shot-inner {
    width: 100%;
    height: 100%;
  }

  .shot-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }
</style>
