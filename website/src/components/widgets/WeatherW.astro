---
// Weather de la app (Widgets/WeatherPanel.xaml): temperaturas, probabilidad de lluvia y la brújula
// de viento relativa al coche (N en rojo, flecha azul de dónde viene el viento).
import { useT } from '../../i18n';
import { weather } from '../../data/preview';
import { icons } from './Icons';
const t = useT(Astro.currentLocale);
const l = t.wl;
---

<div class="ow ow-panel ow-weather" data-live="weather">
  <div class="ow-wsec">
    <span class="ow-label">{l.trackTemp}</span>
    <div class="ow-wrow">
      <svg class="ow-icon" viewBox="0 0 24 24" width="30" height="30" style="color:var(--c-text-2)"><path d={icons.road} fill-rule="evenodd"></path></svg>
      <span class="ow-wbig"><span data-wx="track">{weather.track.toFixed(1)}</span><small>°C</small></span>
    </div>
  </div>
  <div class="ow-wsec">
    <div class="ow-wrow" style="justify-content:space-between">
      <span class="ow-label">{l.airTemp}</span>
      <span class="ow-band-item" style="font-size:16px">
        <svg class="ow-icon" viewBox="0 0 10 14" width="10" height="13" style="color:var(--c-text-2)"><path d={icons.drop}></path></svg>
        {weather.humidity}%
      </span>
    </div>
    <div class="ow-wrow">
      <svg class="ow-icon" viewBox="0 0 24 24" width="32" height="32">
        <circle cx="9" cy="8" r="4" fill="var(--c-accent)"></circle>
        <path d="M7 19 h11 a4 4 0 0 0 0-8 a5.5 5.5 0 0 0-10.5 1.6 a3.2 3.2 0 0 0-.5 6.4z" fill="var(--c-text-2)"></path>
      </svg>
      <span class="ow-wbig"><span data-wx="air">{weather.air.toFixed(1)}</span><small>°C</small></span>
    </div>
  </div>
  <div class="ow-wsec">
    <span class="ow-label">{l.rainChance}</span>
    <div class="ow-wrow">
      <svg class="ow-icon" viewBox="0 0 24 24" width="32" height="32">
        <path d="M6 14 h11 a4 4 0 0 0 0-8 a5.5 5.5 0 0 0-10.5 1.6 A3.2 3.2 0 0 0 6 14z" fill="var(--c-text-2)"></path>
        <path d="M8 17 l-1 3 M12 17 l-1 3 M16 17 l-1 3" stroke="var(--w-info)" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
      <span class="ow-wbig ow-wrain">{weather.rain}%</span>
    </div>
    <span class="ow-label">{l.mostlyDry}</span>
  </div>
  <div class="ow-wsec">
    <span class="ow-label">{l.wind}</span>
    <svg class="ow-compass" viewBox="0 0 120 120" aria-hidden="true">
      <circle cx="60" cy="60" r="46" fill="none" stroke="var(--c-border)" stroke-width="3"></circle>
      <path d="M60 6 l-6 9 h12 z" fill="var(--c-text)"></path>
      <text x="87" y="40" fill="var(--c-text-3)" font-size="13" font-weight="700" text-anchor="middle">E</text>
      <text x="87" y="88" fill="var(--c-text-3)" font-size="13" font-weight="700" text-anchor="middle">S</text>
      <text x="33" y="88" fill="var(--c-text-3)" font-size="13" font-weight="700" text-anchor="middle">W</text>
      <text x="35" y="43" fill="var(--c-error)" font-size="13" font-weight="700" text-anchor="middle">N</text>
      <g class="ow-wind-arrow" data-wx="arrow" style={`transform:rotate(${weather.windFrom}deg)`}>
        <path d="M60 18 l7 16 l-7 -4 l-7 4 z" fill="var(--w-info)"></path>
      </g>
      <g fill="none" stroke="var(--c-text-2)" stroke-width="2.4" stroke-linejoin="round">
        <rect x="51" y="45" width="18" height="32" rx="6"></rect>
        <path d="M53 55 h14 M53 68 h14"></path>
      </g>
    </svg>
    <div class="ow-windspeed">
      <svg class="ow-icon" viewBox="0 0 24 24" width="26" height="26" style="fill:none;stroke:var(--c-text-2);stroke-width:2;stroke-linecap:round"><path d={icons.wind}></path></svg>
      <span data-wx="wind">{weather.windKmh}</span><small>km/h</small>
    </div>
  </div>
</div>
