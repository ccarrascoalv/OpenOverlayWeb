---
/**
 * Encaja un widget de ancho fijo (medidas de la app al 100 %) en el hueco disponible, escalándolo
 * hacia abajo si no cabe. El escalado lo aplica src/scripts/widgets.ts antes de pintar y al cambiar
 * el tamaño; con `max` se limita el tamaño máximo (1 = tamaño real).
 */
interface Props {
  w: number;
  max?: number;
  class?: string;
  style?: string;
}
const { w, max = 1, class: cls, style } = Astro.props;
---

<div class:list={['ow-fit', cls]} style={`--fit-w:${w}px;${style ?? ''}`} data-fit={w} data-fit-max={max}>
  <div class="ow-fit-inner">
    <slot />
  </div>
</div>
