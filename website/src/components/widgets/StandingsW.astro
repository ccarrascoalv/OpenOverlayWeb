---
// Standings de la app (Widgets/StandingsPanel.xaml): agrupada por clase, con cabecera de clase,
// puestos ganados, vueltas y tiempos (morado = más rápida de la clase).
import { useT } from '../../i18n';
import { classes, session, standingsGroups } from '../../data/preview';
import { brandStyle, flagUrl, licClass } from './DriverParts';
import { icons } from './Icons';
const t = useT(Astro.currentLocale);
const l = t.wl;
---

<div class="ow ow-panel ow-table is-standings" data-live="standings" style="width:800px">
  <div class="ow-band">
    <span class="ow-micro">{l.race}</span>
    <span class="ow-band-items">
      <span class="ow-band-item">
        <svg class="ow-icon" viewBox="0 0 24 24" width="16" height="16">
          <circle cx="9" cy="8" r="4" fill="var(--c-accent)"></circle>
          <path d="M7 19 h11 a4 4 0 0 0 0-8 a5.5 5.5 0 0 0-10.5 1.6 a3.2 3.2 0 0 0-.5 6.4z" fill="var(--c-text-2)"></path>
        </svg>
        {session.airTemp}
      </span>
      <span class="ow-band-item">
        <svg class="ow-icon" viewBox="0 0 24 24" width="14" height="14" style="color:var(--c-text-2)"><path d={icons.road} fill-rule="evenodd"></path></svg>
        {session.trackTemp}
      </span>
      <span class="ow-band-item">
        <svg class="ow-icon" viewBox="0 0 10 14" width="9" height="12" style="color:var(--c-text-2)"><path d={icons.drop}></path></svg>
        {session.humidity}
      </span>
    </span>
    <span class="ow-micro">{l.sof} {session.sof}</span>
  </div>
  {
    standingsGroups.map((g) => (
      <>
        <div class:list={['ow-classhead', `cls-${g.cls}`]}>
          {classes[g.cls].name}
          <span>
            <svg class="ow-icon" viewBox="0 0 24 24" width="14" height="14">
              <path d={icons.helmet} fill-rule="evenodd" />
            </svg>
            {classes[g.cls].drivers}
          </span>
          <span>
            {l.sof} {classes[g.cls].sof}
          </span>
        </div>
        {g.rows.map((r, i) => (
          <>
            {g.gapAfter === i && <div class="ow-sep" />}
            <div
              class:list={['ow-row', `cls-${r.cls}`, r.isPlayer && 'is-player', r.inPit && 'is-pit']}
                    data-standings-row={r.leader ? 'leader' : 'car'}
            >
              <span class="ow-pos">{r.pos}</span>
              <span class:list={['ow-places', r.places! > 0 && 'is-up', r.places! < 0 && 'is-down']}>
                {r.places === 0 ? (
                  '–'
                ) : (
                  <svg class="ow-caret" viewBox="0 0 10 10">
                    <path d={r.places! > 0 ? 'M1.5,7 L5,3 L8.5,7' : 'M1.5,3 L5,7 L8.5,3'} />
                  </svg>
                )}
                {Math.abs(r.places!)}
              </span>
              <span class="ow-num">#{r.num}</span>
              <span class="ow-brand" style={brandStyle(r.brand)} />
              <img class="ow-flag" src={flagUrl(r.country)} alt="" width="21" height="14" loading="lazy" decoding="async" />
              <span class="ow-name">{r.name}</span>
              {r.inPit ? (
                <span style="display:flex;gap:4px">
                  {r.penalty && <span class:list={['ow-pen', `is-${r.penalty}`]} />}
                  <span class="ow-chip ow-badge">{l.pit}</span>
                </span>
              ) : r.pit ? (
                <span class="ow-chip ow-badge">
                  L{r.pit.lap}
                  <i />
                  {r.pit.time}
                </span>
              ) : r.penalty ? (
                <span class:list={['ow-pen', `is-${r.penalty}`]} style="justify-self:start" />
              ) : (
                <span />
              )}
              <span class:list={['ow-tyre', `tyre-${r.tyre.toLowerCase()}`]}>{r.tyre}</span>
              <span class="ow-ir">{r.ir}</span>
              <span class:list={['ow-chip ow-ird', r.irDelta >= 0 ? 'is-up' : 'is-down']}>
                <svg class="ow-caret" viewBox="0 0 10 10">
                  <path d={r.irDelta >= 0 ? 'M1.5,7 L5,3 L8.5,7' : 'M1.5,3 L5,7 L8.5,3'} />
                </svg>
                {Math.abs(r.irDelta)}
              </span>
              <span class:list={['ow-chip ow-lic', licClass(r.lic)]}>{r.lic}</span>
              <span class="ow-lap">{r.lapNo}</span>
              <span class:list={['ow-time', r.bestPurple && 'is-purple']}>{r.best}</span>
              <span class:list={['ow-time', r.lastTone && `is-${r.lastTone}`]} data-last>
                {r.last}
              </span>
              <span class:list={['ow-gap', r.leader && 'is-leader']} data-standings-gap>
                {r.leader ? l.leader : r.gap}
              </span>
              {r.leader ? (
                <span class="ow-chip ow-fastest">
                  <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="13" r="8" />
                    <path d="M12 9v4l2.5 2M10 2h4" />
                  </svg>
                </span>
              ) : (
                <span />
              )}
            </div>
          </>
        ))}
      </>
    ))
  }
  <div class="ow-foot">
    <span class="ow-band-item"><span class="ow-micro">{l.lap}</span>{session.lap}</span>
    <span></span>
    <span class="ow-band-item"><span class="ow-micro">{l.time}</span><span data-live-clock>{session.time}</span></span>
  </div>
</div>
