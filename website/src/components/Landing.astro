---
// La página completa. Se renderiza una vez por idioma (src/pages/index.astro y src/pages/es/index.astro);
// los textos salen del idioma de la ruta (Astro.currentLocale).
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Features from './Features.astro';
import Widgets from './Widgets.astro';
import Panel from './Panel.astro';
import GetStarted from './GetStarted.astro';
import Faq from './Faq.astro';
import Footer from './Footer.astro';
import Gallery from './Gallery.astro';
import SupportButton from './SupportButton.astro';
---

<Base>
  <div id="top"></div>
  <Header />
  <main id="main">
    <Hero />
    <Features />
    <Widgets />
    <Panel />
    <GetStarted />
    <Faq />
    <Gallery />
  </main>
  <Footer />
  <SupportButton />
  <script is:inline>
    // Encaja los widgets en su hueco antes del primer pintado (sin saltos de maquetación).
    document.querySelectorAll('[data-fit]').forEach(function (box) {
      var w = Number(box.dataset.fit), max = Number(box.dataset.fitMax || 1), inner = box.firstElementChild;
      if (!box.clientWidth) return;
      var s = Math.min(max, box.clientWidth / w);
      inner.style.transform = 'scale(' + s + ')';
      box.style.height = inner.offsetHeight * s + 'px';
    });
  </script>
</Base>

<script>
  import { URLS } from '../config';
  import { initHeader, initLiveMockups, initReveal } from '../scripts/motion';
  import { initRelease } from '../scripts/release';
  import { initFit, initGallery, initWidgets } from '../scripts/widgets';

  // Foto del hero elegida por el script en línea de Hero.astro: actualiza el circuito del mockup y el crédito.
  const hero = (window as unknown as { __ooHero?: { circuit: string | null; credit: string } }).__ooHero;
  if (hero) {
    if (hero.circuit) document.querySelectorAll('[data-hero-circuit]').forEach((el) => (el.textContent = hero.circuit));
    document.querySelectorAll('[data-hero-credit]').forEach((el) => (el.textContent = hero.credit));
  }

  initHeader();
  initReveal();
  initLiveMockups();
  initFit();
  initGallery();
  initWidgets();
  initRelease(URLS.api);
</script>
