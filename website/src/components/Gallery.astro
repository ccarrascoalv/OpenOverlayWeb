---
// Galería de overlays: cada widget de la app en movimiento sobre una captura del simulador.
// Pestañas accesibles (flechas, Inicio y Fin); el widget se escala para caber en el escenario.
import { Image } from 'astro:assets';
import backdrop from '../assets/heroes/porsche-gtp.jpg';
import Fit from './widgets/Fit.astro';
import RelativeW from './widgets/RelativeW.astro';
import StandingsW from './widgets/StandingsW.astro';
import CockpitW from './widgets/CockpitW.astro';
import FuelW from './widgets/FuelW.astro';
import FlagsW from './widgets/FlagsW.astro';
import TiresW from './widgets/TiresW.astro';
import PedalsW from './widgets/PedalsW.astro';
import WeatherW from './widgets/WeatherW.astro';
import { useT } from '../i18n';
const t = useT(Astro.currentLocale);
const g = t.gallery;

// Descripción de cada widget: la misma de la sección de widgets.
const all = t.widgets.groups.flatMap((gr) => gr.items);
const desc = (name: string) => all.find((i) => i.name === name)?.text ?? '';

const items = [
  { id: 'relative', name: 'Relative', w: 640, C: RelativeW },
  { id: 'standings', name: 'Standings', w: 800, C: StandingsW },
  { id: 'cockpit', name: 'Cockpit', w: 820, C: CockpitW },
  { id: 'fuel', name: 'Fuel calculator', w: 300, C: FuelW },
  { id: 'flags', name: 'Flags', w: 320, C: FlagsW },
  { id: 'tires', name: 'Tires', w: 340, C: TiresW },
  { id: 'pedals', name: 'Pedal trace', w: 820, C: PedalsW },
  { id: 'weather', name: 'Weather', w: 230, C: WeatherW },
];
---

<section class="section" id="gallery" aria-labelledby="gallery-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 id="gallery-title">{g.title}</h2>
      <p>{g.intro}</p>
    </div>

    <div class="gal" data-gallery data-reveal>
      <div class="gal-tabs" role="tablist" aria-label={g.tabsLabel} aria-orientation="vertical">
        {
          items.map((it, i) => (
            <button
              type="button"
              role="tab"
              id={`gal-tab-${it.id}`}
              aria-controls={`gal-panel-${it.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {it.name}
            </button>
          ))
        }
      </div>

      <div class="gal-stage">
        <Image src={backdrop} alt="" class="gal-bg" widths={[800, 1280, 1920]} sizes="(min-width: 1000px) 900px, 100vw" loading="lazy" />
        <div class="gal-shade"></div>
        {
          items.map((it, i) => {
            const content = (
              <>
                <div class="gal-widget" role="img" aria-label={`${it.name}: ${t.hero.sceneLabel}`}>
                  <div aria-hidden="true" style={`width:min(100%, ${it.w}px)`}>
                    <Fit w={it.w}>
                      <it.C />
                    </Fit>
                  </div>
                </div>
                <div class="gal-caption">
                  <h3>{it.name}</h3>
                  <p>{desc(it.name)}</p>
                </div>
              </>
            );
            // Solo el primer widget se pinta al cargar; el resto espera en un <template> hasta que
            // se elige su pestaña, para no hacer pesada la página.
            return (
              <div class="gal-panel" role="tabpanel" id={`gal-panel-${it.id}`} aria-labelledby={`gal-tab-${it.id}`} hidden={i !== 0} tabindex="0">
                {i === 0 ? content : <template data-gal-template>{content}</template>}
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  .gal {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: var(--space-5);
  }

  .gal-tabs {
    display: grid;
    align-content: start;
    gap: var(--space-1);
  }

  .gal-tabs button {
    position: relative;
    isolation: isolate;
    padding: 0.65rem 1rem;
    border: 0;
    border-radius: var(--radius-2);
    background: transparent;
    color: var(--c-text-2);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    text-align: left;
    cursor: pointer;
    transition: color var(--dur-1) var(--ease-out);
  }

  .gal-tabs button::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--c-surface);
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out);
    z-index: -1;
  }

  .gal-tabs button:hover {
    color: var(--c-text);
  }

  .gal-tabs button:hover::before {
    opacity: 1;
  }

  .gal-tabs button[aria-selected='true'] {
    color: var(--c-accent);
  }

  .gal-tabs button[aria-selected='true']::before {
    opacity: 1;
    background: var(--c-surface-alt);
  }

  .gal-stage {
    position: relative;
    isolation: isolate;
    min-height: 34rem;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-3);
    overflow: hidden;
  }

  .gal-stage :global(.gal-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 35% 50%;
    filter: saturate(1.05) brightness(0.7);
    z-index: -2;
  }

  .gal-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, color-mix(in srgb, var(--c-bg) 20%, transparent) 0%, color-mix(in srgb, var(--c-bg) 35%, transparent) 55%, var(--c-bg) 100%);
  }

  .gal-panel {
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 34rem;
    padding: clamp(1rem, 0.5rem + 2vw, 2rem);
    animation: gal-in var(--dur-3) var(--ease-out);
  }

  .gal-panel[hidden] {
    display: none;
  }

  .gal-widget {
    display: grid;
    place-items: center;
  }

  .gal-widget > div {
    min-width: 0;
  }

  .gal-caption {
    display: grid;
    gap: var(--space-2);
    max-width: 44rem;
    margin-top: var(--space-5);
  }

  .gal-caption h3 {
    font-size: var(--step-3);
  }

  .gal-caption p {
    color: var(--c-text-2);
  }

  @keyframes gal-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (max-width: 860px) {
    .gal {
      grid-template-columns: minmax(0, 1fr);
    }

    .gal-tabs {
      grid-auto-flow: column;
      grid-auto-columns: max-content;
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: 2px;
    }

    .gal-stage,
    .gal-panel {
      min-height: 26rem;
    }
  }
</style>
