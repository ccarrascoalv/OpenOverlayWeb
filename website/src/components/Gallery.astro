---
// Galería de overlays: capturas reales de cada widget tal y como lo dibuja la app (vista previa del
// panel de control, tamaño 100 %). Todas las capturas son 16:9, así el escenario nunca cambia de tamaño.
// Pestañas accesibles (flechas, Inicio y Fin).
import { Image } from 'astro:assets';
import relative from '../assets/gallery/relative.webp';
import standings from '../assets/gallery/standings.webp';
import trackmap from '../assets/gallery/trackmap.webp';
import flags from '../assets/gallery/flags.webp';
import incidents from '../assets/gallery/incidents.webp';
import cockpit from '../assets/gallery/cockpit.webp';
import tires from '../assets/gallery/tires.webp';
import fuel from '../assets/gallery/fuel.webp';
import delta from '../assets/gallery/delta.webp';
import pedals from '../assets/gallery/pedals.webp';
import track from '../assets/gallery/track.webp';
import weather from '../assets/gallery/weather.webp';
import { useT } from '../i18n';
const t = useT(Astro.currentLocale);
const g = t.gallery;

// Descripción de cada widget: la misma de la sección de widgets.
const all = t.widgets.groups.flatMap((gr) => gr.items);
const desc = (name: string) => all.find((i) => i.name === name)?.text ?? '';

// Mismo orden que la barra lateral de la app.
const items = [
  { id: 'relative', name: 'Relative', img: relative },
  { id: 'standings', name: 'Standings', img: standings },
  { id: 'trackmap', name: 'Track map', img: trackmap },
  { id: 'flags', name: 'Flags', img: flags },
  { id: 'incidents', name: 'Incidents', img: incidents },
  { id: 'cockpit', name: 'Cockpit', img: cockpit },
  { id: 'tires', name: 'Tires', img: tires },
  { id: 'fuel', name: 'Fuel calculator', img: fuel },
  { id: 'delta', name: 'Delta', img: delta },
  { id: 'pedals', name: 'Pedal trace', img: pedals },
  { id: 'track', name: 'Track & session', img: track },
  { id: 'weather', name: 'Weather', img: weather },
];
---

<section class="section" id="gallery" aria-labelledby="gallery-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 id="gallery-title">{g.title}</h2>
      <p>{g.intro}</p>
    </div>

    <div class="gal" data-gallery data-reveal>
      <div class="gal-tabs" role="tablist" aria-label={g.tabsLabel} aria-orientation="vertical">
        {
          items.map((it, i) => (
            <button
              type="button"
              role="tab"
              id={`gal-tab-${it.id}`}
              aria-controls={`gal-panel-${it.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {it.name}
            </button>
          ))
        }
      </div>

      <div class="gal-panels">
        {
          items.map((it, i) => (
            <div class="gal-panel" role="tabpanel" id={`gal-panel-${it.id}`} aria-labelledby={`gal-tab-${it.id}`} hidden={i !== 0} tabindex="0">
              <div class="gal-stage">
                {/* Las pestañas ocultas no descargan su captura hasta que se eligen (loading="lazy" + hidden). */}
                <Image
                  src={it.img}
                  alt={g.alt.replace('{name}', it.name)}
                  widths={[640, 1000, it.img.width]}
                  sizes="(min-width: 1280px) 1000px, (min-width: 860px) calc(100vw - 20rem), calc(100vw - 2rem)"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="gal-caption">
                <h3>{it.name}</h3>
                <p>{desc(it.name)}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .gal {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: var(--space-5);
  }

  .gal-tabs {
    display: grid;
    align-content: start;
    gap: 2px;
  }

  .gal-tabs button {
    position: relative;
    isolation: isolate;
    padding: 0.5rem 1rem;
    border: 0;
    border-radius: var(--radius-2);
    background: transparent;
    color: var(--c-text-2);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
    transition: color var(--dur-1) var(--ease-out);
  }

  .gal-tabs button::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--c-surface);
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out);
    z-index: -1;
  }

  .gal-tabs button:hover {
    color: var(--c-text);
  }

  .gal-tabs button:hover::before {
    opacity: 1;
  }

  .gal-tabs button[aria-selected='true'] {
    color: var(--c-accent);
  }

  .gal-tabs button[aria-selected='true']::before {
    opacity: 1;
    background: var(--c-surface-alt);
  }

  .gal-panel {
    display: grid;
    gap: var(--space-5);
    animation: gal-in var(--dur-3) var(--ease-out);
  }

  .gal-panel[hidden] {
    display: none;
  }

  /* Tamaño fijo (16:9) para todos los widgets: cambiar de pestaña no mueve nada. */
  .gal-stage {
    aspect-ratio: 16 / 9;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-3);
    overflow: hidden;
  }

  .gal-stage :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gal-caption {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    max-width: 44rem;
    /* Reserva tres líneas de texto para que la página no salte al cambiar de widget. */
    min-height: calc(var(--step-3) * 1.2 + var(--space-2) + 4.8em);
  }

  .gal-caption h3 {
    font-size: var(--step-3);
  }

  .gal-caption p {
    color: var(--c-text-2);
  }

  @keyframes gal-in {
    from {
      opacity: 0;
    }
  }

  @media (max-width: 860px) {
    .gal {
      grid-template-columns: minmax(0, 1fr);
    }

    .gal-tabs {
      grid-auto-flow: column;
      grid-auto-columns: max-content;
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: 2px;
    }
  }
</style>
