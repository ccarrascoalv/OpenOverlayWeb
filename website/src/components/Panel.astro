---
import ShotFrame from './ShotFrame.astro';
import panelEn from '../assets/shots/panel-en.webp';
import panelEs from '../assets/shots/panel-es.webp';
import editorEn from '../assets/shots/editor-en.webp';
import editorEs from '../assets/shots/editor-es.webp';
import { useT } from '../i18n';
const t = useT(Astro.currentLocale);
const p = t.panel;
// Capturas reales de la app en el idioma de la página.
const shots = t.lang === 'es' ? { panel: panelEs, editor: editorEs } : { panel: panelEn, editor: editorEn };
---

<section class="section" id="panel" aria-labelledby="panel-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2 id="panel-title">{p.title}</h2>
      <p>{p.intro}</p>
    </div>

    <div class="feature-row" data-reveal>
      <div class="feature-text">
        <h3>{p.control.title}</h3>
        <ul class="ticks">
          {p.control.items.map((i) => <li>{i}</li>)}
        </ul>
      </div>
      <ShotFrame image={shots.panel} alt={p.control.alt} />
    </div>

    <div class="feature-row" data-reveal>
      <div class="feature-text">
        <h3>{p.layouts.title}</h3>
        <ul class="ticks">
          {p.layouts.items.map((i) => <li>{i}</li>)}
        </ul>
      </div>
      <ShotFrame image={shots.editor} alt={p.layouts.alt} />
    </div>

    <div class="details">
      <div class="detail" data-reveal>
        <h3>{p.comfort.title}</h3>
        <ul class="ticks">
          {p.comfort.items.map((i) => <li>{i}</li>)}
        </ul>
      </div>
      <div class="detail" data-reveal style="--reveal-i: 1">
        <h3>{p.reliability.title}</h3>
        <ul class="ticks">
          {p.reliability.items.map((i) => <li>{i}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .feature-row {
    display: grid;
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .feature-row + .feature-row {
    margin-top: var(--space-8);
  }

  .feature-text {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--space-5);
    align-items: start;
  }

  .feature-text .ticks {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-6);
  }

  .feature-text h3 {
    font-size: var(--step-3);
  }

  .ticks {
    display: grid;
    gap: var(--space-3);
    list-style: none;
  }

  .ticks li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--c-text-2);
  }

  .ticks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.7rem;
    height: 2px;
    background: var(--c-text-3);
  }

  .details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-8);
    padding-top: var(--space-7);
    border-top: 1px solid var(--c-border-soft);
  }

  .detail {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  .detail .ticks li {
    font-size: var(--step--1);
  }

  @media (max-width: 900px) {
    .feature-text,
    .feature-text .ticks {
      grid-template-columns: minmax(0, 1fr);
    }

    .details {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-7);
    }
  }
</style>
