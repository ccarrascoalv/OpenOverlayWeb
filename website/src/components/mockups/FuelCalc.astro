---
import WidgetFrame from '../WidgetFrame.astro';
import { useT } from '../../i18n';
const t = useT(Astro.currentLocale);

interface Props {
  class?: string;
  style?: string;
}
const { class: cls, style } = Astro.props;
const m = t.mock.fuel;

// Datos de ejemplo: depósito de 120 L, ~2,71 L por vuelta.
const capacity = 120;
const remaining = 23.4;
const avg = 2.71;
const toFinish = 31.2;
---

<WidgetFrame title={m.title} live class={cls} style={style}>
  <div class="fuel" data-mock="fuel" data-capacity={capacity} data-remaining={remaining} data-avg={avg} data-finish={toFinish}>
    <div class="fuel-main">
      <div>
        <span class="fuel-label">{m.remaining}</span>
        <span class="fuel-big"><span data-fuel="remaining">{remaining.toFixed(1)}</span><small>L</small></span>
      </div>
      <div class="fuel-laps">
        <span class="fuel-label">{m.lapsLeft}</span>
        <span class="fuel-mid" data-fuel="laps">{(remaining / avg).toFixed(1)}</span>
      </div>
    </div>
    <div class="fuel-tank" aria-hidden="true">
      <span class="fuel-level" data-fuel="level" style={`transform: scaleX(${remaining / capacity})`}></span>
      <span class="fuel-need" style={`transform: scaleX(${toFinish / capacity})`}></span>
    </div>
    <div class="fuel-stats">
      <span class="fuel-label">{m.perLap}</span>
      <div class="fuel-cons">
        {
          m.perLapStats.map((label, i) => (
            <span>
              <small>{label}</small>
              {[2.74, avg, 2.66, 2.8][i].toFixed(2)}
            </span>
          ))
        }
      </div>
    </div>
    <div class="fuel-foot">
      <span><small>{m.toFinish}</small><span data-fuel="finish">{toFinish.toFixed(1)}</span> L</span>
      <span class="fuel-refuel"><small>{m.refuel}</small>+<span data-fuel="refuel">{(toFinish - remaining).toFixed(1)}</span> L</span>
    </div>
  </div>
</WidgetFrame>

<style>
  .fuel {
    display: grid;
    gap: 0.55rem;
    padding: 0.3rem 0.75rem 0.45rem;
  }

  .fuel-label,
  .fuel small {
    display: block;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-text-3);
  }

  .fuel-main {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-4);
  }

  .fuel-big {
    font-size: 2.1rem;
    font-weight: 700;
    line-height: 1;
  }

  .fuel-big small {
    display: inline;
    margin-left: 0.15rem;
    font-size: 0.95rem;
    text-transform: none;
  }

  .fuel-laps {
    text-align: right;
  }

  .fuel-mid {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1;
  }

  .fuel-tank {
    position: relative;
    height: 6px;
    border-radius: 3px;
    background: var(--c-surface-alt);
    overflow: hidden;
  }

  .fuel-level,
  .fuel-need {
    position: absolute;
    inset: 0;
    transform-origin: left center;
  }

  .fuel-level {
    background: var(--c-live);
    transition: transform var(--dur-3) var(--ease-out);
  }

  .fuel-need {
    border-right: 2px solid var(--c-warn);
    background: transparent;
  }

  .fuel-cons {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.4rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .fuel-cons small {
    font-size: 0.66rem;
  }

  .fuel-foot {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: 0.45rem;
    border-top: 1px solid var(--c-border-soft);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .fuel-refuel {
    text-align: right;
    color: var(--c-warn);
  }
</style>
