---
import '@fontsource/barlow-semi-condensed/latin-500.css';
import '@fontsource/barlow-semi-condensed/latin-600.css';
import '@fontsource/barlow-semi-condensed/latin-700.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
import '../styles/widgets.css';
import '@fontsource/barlow-semi-condensed/latin-700-italic.css';
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import barlow700 from '@fontsource/barlow-semi-condensed/files/barlow-semi-condensed-latin-700-normal.woff2?url';
import barlow600 from '@fontsource/barlow-semi-condensed/files/barlow-semi-condensed-latin-600-normal.woff2?url';
import JsonLd from '../components/JsonLd.astro';
import tokens from '../styles/tokens.css?raw';
import { GOOGLE_SITE_VERIFICATION } from '../config';
import { defaultLang, langPath, languages, useT, type Lang } from '../i18n';
const t = useT(Astro.currentLocale);

interface Props {
  /** Páginas que no deben indexarse (la 404): sin canonical, hreflang ni datos estructurados. */
  noindex?: boolean;
  title?: string;
}
const { noindex = false, title = t.meta.title } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const canonical = Astro.site && !noindex ? abs(langPath(t.lang as Lang)) : undefined;
const alternates = (Object.keys(languages) as Lang[]).map((l) => ({ lang: l, href: abs(langPath(l)) }));
const ogFile = t.lang === 'es' ? 'og-es.png' : 'og.png';
const ogImage = Astro.site ? new URL(`${base}${ogFile}`, Astro.site).href : `${base}${ogFile}`;
// Color de la barra del navegador en móvil: el fondo de la web, leído de tokens.css.
const themeColor = tokens.match(/--c-bg:\s*([^;\s]+)/)?.[1];
const otherLocales = (Object.keys(languages) as Lang[]).filter((l) => l !== t.lang).map((l) => useT(l).ogLocale);
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {/* Fuentes de la primera pantalla: se precargan para que el texto del hero se pinte antes. */}
    {[interFont, barlow700, barlow600].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <meta name="description" content={t.meta.description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={themeColor} />
    <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
    {canonical && <link rel="canonical" href={canonical} />}
    {/* hreflang necesita URLs absolutas: solo se emite cuando hay SITE_URL (en el despliegue). */}
    {canonical && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {canonical && <link rel="alternate" hreflang="x-default" href={abs(langPath(defaultLang))} />}
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.ogLocale} />
    {otherLocales.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta property="og:site_name" content="OpenOverlay" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.meta.ogAlt} />
    {!noindex && <JsonLd />}

    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <slot />
  </body>
</html>
