---
import '@fontsource/barlow-semi-condensed/latin-500.css';
import '@fontsource/barlow-semi-condensed/latin-600.css';
import '@fontsource/barlow-semi-condensed/latin-700.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';
import '../styles/widgets.css';
import '@fontsource/barlow-semi-condensed/latin-700-italic.css';
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import barlow700 from '@fontsource/barlow-semi-condensed/files/barlow-semi-condensed-latin-700-normal.woff2?url';
import barlow600 from '@fontsource/barlow-semi-condensed/files/barlow-semi-condensed-latin-600-normal.woff2?url';
import { defaultLang, langPath, languages, useT, type Lang } from '../i18n';
const t = useT(Astro.currentLocale);

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const canonical = Astro.site ? abs(langPath(t.lang as Lang)) : undefined;
const alternates = (Object.keys(languages) as Lang[]).map((l) => ({ lang: l, href: abs(langPath(l)) }));
const ogImage = Astro.site ? new URL(`${base}og.png`, Astro.site).href : `${base}og.png`;
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    {/* Fuentes de la primera pantalla: se precargan para que el texto del hero se pinte antes. */}
    {[interFont, barlow700, barlow600].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <meta name="description" content={t.meta.description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {/* hreflang necesita URLs absolutas: solo se emite cuando hay SITE_URL (en el despliegue). */}
    {canonical && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {canonical && <link rel="alternate" hreflang="x-default" href={abs(langPath(defaultLang))} />}
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:site_name" content="OpenOverlay" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <slot />
  </body>
</html>
